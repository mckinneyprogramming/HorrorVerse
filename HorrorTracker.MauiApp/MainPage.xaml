<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HorrorTracker.MauiApp.MainPage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="28">

            <Label
                Text="ENTER THE HORRORVERSE"
                Style="{StaticResource AccentLabel}"
                SemanticProperties.HeadingLevel="Level2" />

            <Border Margin="0,8,0,0">
                <VerticalStackLayout Spacing="20">
                    <Label
                        Text="HorrorVerse"
                        Style="{StaticResource Headline}"
                        SemanticProperties.HeadingLevel="Level1" />

                    <BoxView
                        HeightRequest="2"
                        Color="{StaticResource Blood}"
                        HorizontalOptions="Fill"
                        Margin="40,0" />

                    <Label
                        Text="Every scream, every shadow, every story — all connected."
                        Style="{StaticResource SubHeadline}"
                        SemanticProperties.Description="HorrorVerse tagline" />

                    <Button
                        x:Name="CounterBtn"
                        Text="Enter the darkness"
                        Style="{StaticResource PrimaryButton}"
                        SemanticProperties.Hint="Sample interaction button"
                        Clicked="OnCounterClicked"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <Label
                Text="Track films, series, books, and more."
                TextColor="{StaticResource TextMuted}"
                FontSize="13"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
